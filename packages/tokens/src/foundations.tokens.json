  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(16, 40, 46, 0.04)",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0"
      },
      "$extensions": {
        "chayns": {
          "cssName": "--shadow-card",
          "cssValue": "0 1px 3px rgba(16, 40, 46, 0.04)",
          "dark": "0 1px 3px rgba(0, 0, 0, 0.3)"
        }
      }
    },
    "hover": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(16, 40, 46, 0.28)",
        "offsetX": "0",
        "offsetY": "16px",
        "blur": "32px",
        "spread": "-14px"
      },
      "$extensions": {
        "chayns": {
          "cssName": "--shadow-hover",
          "cssValue": "0 16px 32px -14px rgba(16, 40, 46, 0.28)",
          "dark": "0 16px 32px -14px rgba(0, 0, 0, 0.5)"
        }
      }
    },
    "pop": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(16, 40, 46, 0.28)",
        "offsetX": "0",
        "offsetY": "16px",
        "blur": "34px",
        "spread": "-12px"
      },
      "$extensions": {
        "chayns": {
          "cssName": "--shadow-pop",
          "cssValue": "0 16px 34px -12px rgba(16, 40, 46, 0.28)",
          "dark": "0 16px 34px -12px rgba(0, 0, 0, 0.55)"
        }
      }
    },
    "button": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(var(--accent-rgb), 0.45)",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-4px"
      },
      "$extensions": {
        "chayns": {
          "cssName": "--shadow-btn",
          "cssValue": "0 4px 12px -4px rgba(var(--accent-rgb), 0.45)"
        }
      }
    },
    "button-hover": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(var(--accent-rgb), 0.6)",
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "20px",
        "spread": "-6px"
      },
      "$extensions": {
        "chayns": {
          "cssName": "--shadow-btn-hover",
          "cssValue": "0 8px 20px -6px rgba(var(--accent-rgb), 0.6)"
        }
      }
    }
  }
}
