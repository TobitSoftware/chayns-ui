{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "density": {
    "scale-factor": {
      "$type": "number",
      "$value": 1,
      "$description": "Global density scale factor.",
      "$extensions": {
        "chayns": { "cssName": "--sf", "density": { "s": 0.9, "m": 1, "l": 1.125 } }
      }
    },
    "unit": {
      "$type": "string",
      "$value": "calc(1px * var(--sf))",
      "$description": "Source unit required by confirmed density formulas.",
      "$extensions": { "chayns": { "cssName": "--u" } }
    }
  },
  "spacing": {
    "1": {
      "$type": "string",
      "$value": "calc(4 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-1" } }
    },
    "2": {
      "$type": "string",
      "$value": "calc(8 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-2" } }
    },
    "3": {
      "$type": "string",
      "$value": "calc(12 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-3" } }
    },
    "4": {
      "$type": "string",
      "$value": "calc(16 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-4" } }
    },
    "5": {
      "$type": "string",
      "$value": "calc(20 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-5" } }
    },
    "6": {
      "$type": "string",
      "$value": "calc(24 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--sp-6" } }
    }
  },
  "popover": {
    "$type": "number",
    "$value": 1000,
    "$extensions": {
      "chayns": {
        "cssName": "--z-popover",
        "cssValue": "1000"
      }
    }
  },
  "button": {
    "padding-block": {
      "$type": "string",
      "$value": "calc(11 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--btn-py" } }
    },
    "padding-inline": {
      "$type": "string",
      "$value": "calc(22 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--btn-px" } }
    },
    "control-height": {
      "$type": "string",
      "$value": "calc(42 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--ctrl-h" } }
    }
  },
  "input": {
    "padding-block": {
      "$type": "string",
      "$value": "calc(13 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--input-py" } }
    },
    "padding-inline": {
      "$type": "string",
      "$value": "calc(16 * var(--u))",
      "$extensions": { "chayns": { "cssName": "--input-px" } }
    }
  },
