{
  "name": "@chayns-ui/core",
  "version": "0.8.0",
  "description": "Accessible React core components for chayns UI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobitSoftware/chayns-ui.git",
    "directory": "packages/core"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button.css": "./dist/button.css",
    "./badge.css": "./dist/badge.css",
    "./skeleton.css": "./dist/skeleton.css",
    "./spinner.css": "./dist/spinner.css",
    "./progress.css": "./dist/progress.css",
    "./banner.css": "./dist/banner.css",
    "./combo-box.css": "./dist/combo-box.css",
    "./card.css": "./dist/card.css",
    "./avatar.css": "./dist/avatar.css",
    "./list.css": "./dist/list.css",
    "./accordion.css": "./dist/accordion.css",
    "./popup.css": "./dist/popup.css",
    "./split-button.css": "./dist/split-button.css",
    "./text-field.css": "./dist/text-field.css",
    "./date-time-picker.css": "./dist/date-time-picker.css",
    "./text-area.css": "./dist/text-area.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./switch.css": "./dist/switch.css",
    "./radio-group.css": "./dist/radio-group.css",
    "./segmented-control.css": "./dist/segmented-control.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && node ../../tooling/copy-core-css.mjs && tsc -b tsconfig.build.json --force",
    "clean": "node ../../tooling/clean-package.mjs core",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
