{
  "name": "@chayns-ui/business",
  "version": "0.1.0",
  "description": "Business components composed from chayns UI Core",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobitSoftware/chayns-ui.git",
    "directory": "packages/business"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@chayns-ui/core": "workspace:^",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@chayns-ui/core": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && node ../../tooling/copy-business-css.mjs && tsc -b tsconfig.build.json --force",
    "clean": "node ../../tooling/clean-package.mjs business",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0"
  }
}
