{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chayns UI component specification metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "package",
    "category",
    "status",
    "useWhen",
    "doNotUseWhen",
    "alternatives",
    "sourceReferences",
    "checkedOn",
    "stories"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "enum": [
        "@chayns-ui/core",
        "@chayns-ui/layout"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Core",
        "Layout",
        "Business"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "blocked",
        "ready",
        "implemented"
      ]
    },
    "useWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "doNotUseWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stories": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
