{
  "name": "chayns-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "clean": "pnpm --recursive --if-present run clean",
    "consumer:check": "node tooling/verify-consumer.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'packages/**/*.css'",
    "package:check": "node tooling/verify-package.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "test": "vitest run",
    "test:storybook": "vitest run --project storybook",
    "test:types": "tsc -p packages/core/tsconfig.type-tests.json --noEmit",
    "test:unit": "vitest run --project unit --coverage",
    "tokens:check": "node tooling/verify-tokens.mjs",
    "tree-shaking:check": "node tooling/verify-tree-shaking.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test:unit && pnpm test:types && pnpm build && pnpm tokens:check && pnpm storybook:build && pnpm package:check && pnpm tree-shaking:check && pnpm consumer:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/browser": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.4.6",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.4.6",
    "style-dictionary": "5.5.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
